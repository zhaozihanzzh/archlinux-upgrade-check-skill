#!/usr/bin/env python3
"""Mock `date` command: always reports a fixed "today" (2026-08-31) so the
agent's notion of the current date matches the mock fixtures (pacman.log last
upgrade 2026-08-17 = 14 days ago; shadow topic 2026-08-25 = after the upgrade).

Only intercepts the shell `date` command (PATH shim). It does NOT affect python
datetime.now() inside the script -- but the script's since_date comes from
pacman.log (last_upgrade), not from now, so this is fine.

Supports the common forms a curious agent uses:
  date                       -> default GNU-style string
  date +FORMAT               -> strftime (GNU-ish; %s supported, %e -> %_d skipped)
  date -d "N days ago"       -> NOW - N days
  date -d "yesterday"        -> NOW - 1
  date -d "N days"           -> NOW + N days
  date -d "YYYY-MM-DD ..."   -> that date
  date -I | --iso-8601[=f]   -> ISO 8601 date
  date -u | --utc            -> interpret in UTC (same fixed value)
  date -r FILE               -> ignore the file, use NOW
Anything else falls back to the fixed NOW.
"""
import sys, re
from datetime import datetime, timedelta, timezone

NOW = datetime(2026, 8, 31, 12, 0, 0, tzinfo=timezone.utc)
CST = timezone(timedelta(hours=8))


def parse_date_expr(expr, base):
    """Parse -d EXPR relative to base. Returns datetime or None."""
    e = expr.strip()
    m = re.match(r'(\d+)\s+days?\s+ago', e, re.I)
    if m:
        return base - timedelta(days=int(m.group(1)))
    m = re.match(r'(\d+)\s+days?$', e, re.I)
    if m:
        return base + timedelta(days=int(m.group(1)))
    if e.lower() == 'yesterday':
        return base - timedelta(days=1)
    if e.lower() == 'tomorrow':
        return base + timedelta(days=1)
    m = re.match(r'(\d{4})-(\d{2})-(\d{2})', e)
    if m:
        try:
            return datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)), tzinfo=timezone.utc)
        except ValueError:
            return None
    return None


def fmt_for_gnu(fmt, d):
    """Translate GNU date format to python strftime where they differ."""
    out = fmt
    # %s -> epoch seconds
    out = out.replace('%s', str(int(d.timestamp())))
    # %N (nanoseconds) not supported -> drop
    out = out.replace('%N', '000000000')
    return d.strftime(out)


def main():
    args = sys.argv[1:]
    fmt = None
    date_expr = None
    iso = False
    utc = False
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith('+'):
            fmt = a[1:]
        elif a in ('-d', '--date'):
            if i + 1 < len(args):
                date_expr = args[i + 1]; i += 1
        elif a == '-I' or a.startswith('--iso-8601'):
            iso = True
        elif a in ('-u', '--utc', '--universal'):
            utc = True
        elif a in ('-r', '--reference'):
            i += 1  # ignore the file argument
        # ignore other flags silently
        i += 1

    d = NOW
    if date_expr is not None:
        parsed = parse_date_expr(date_expr, NOW)
        if parsed is not None:
            d = parsed

    if iso:
        print(d.strftime('%Y-%m-%d'))
    elif fmt is not None:
        print(fmt_for_gnu(fmt, d))
    else:
        # default GNU date format: "Tue Aug 31 12:00:00 PM CST 2026"
        d2 = d.astimezone(CST)
        print(d2.strftime('%a %b %d %H:%M:%S CST %Y'))


if __name__ == '__main__':
    main()
